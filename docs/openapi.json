  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "enum": [
              "standard",
              "agentic"
            ],
            "title": "Mode",
            "default": "standard"
          },
          "config_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config Id",
            "description": "B1, B2 or M1 (standard mode only)"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "Body_upload_document_api_admin_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Title"
          },
          "publisher": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Publisher"
          },
          "lang": {
            "type": "string",
            "enum": [
              "id",
              "en"
            ],
            "title": "Lang"
          },
          "parser": {
            "type": "string",
            "enum": [
              "legal_id",
              "sections_smk2",
              "sections_en"
            ],
            "title": "Parser"
          },
          "source_url": {
            "type": "string",
            "maxLength": 500,
            "title": "Source Url",
            "default": ""
          },
          "short_title": {
            "type": "string",
            "maxLength": 60,
            "title": "Short Title",
            "default": ""
          },
          "api_allowed": {
            "type": "boolean",
            "title": "Api Allowed",
            "default": false
          },
          "index": {
            "type": "boolean",
            "title": "Index",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "file",
          "title",
          "publisher",
          "lang",
          "parser"
        ],
        "title": "Body_upload_document_api_admin_documents_post"
      },
      "FeedbackRequest": {
        "properties": {
          "query_id": {
            "type": "integer",
            "title": "Query Id"
          },
          "thumbs": {
            "type": "integer",
            "enum": [
              -1,
              1
            ],
            "title": "Thumbs"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "thumbs"
        ],
        "title": "FeedbackRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Token"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "LoginRequest"
      },
      "ScoreRequest": {
        "properties": {
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "correctness": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Correctness"
          },
          "completeness": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Completeness"
          },
          "usefulness": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Usefulness"
          },
          "citation_ok": {
            "type": "boolean",
            "title": "Citation Ok"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "correctness",
          "completeness",
          "usefulness",
          "citation_ok"
        ],
        "title": "ScoreRequest"
      },
      "SessionInfo": {
        "properties": {
          "role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "admin",
                  "reviewer"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "role"
        ],
        "title": "SessionInfo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
