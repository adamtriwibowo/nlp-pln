  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "enum": [
              "standard",
              "agentic"
            ],
            "title": "Mode",
            "default": "standard"
          },
          "config_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config Id",
            "description": "B1, B2 or M1 (standard mode only)"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "Body_upload_document_api_admin_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Title"
          },
          "publisher": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Publisher"
          },
          "lang": {
            "type": "string",
            "enum": [
              "id",
              "en"
            ],
            "title": "Lang"
          },
          "parser": {
            "type": "string",
            "enum": [
              "legal_id",
              "sections_smk2",
              "sections_en"
            ],
            "title": "Parser"
          },
          "source_url": {
            "type": "string",
            "maxLength": 500,
            "title": "Source Url",
            "default": ""
          },
          "short_title": {
            "type": "string",
            "maxLength": 60,
            "title": "Short Title",
            "default": ""
          },
          "api_allowed": {
            "type": "boolean",
            "title": "Api Allowed",
            "default": false
          },
          "index": {
